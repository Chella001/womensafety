rules_version = '2';

// SafeHer — ALL Firestore access goes through the Spring Boot backend (Firebase Admin SDK), which bypasses these rules
// and enforces authentication, ownership and the administrator allow-list in Java. Browsers must never read or write
// Firestore directly, so every client request is denied, including for signed-in users and for these collections:
//
//   users/{uid}                          profiles (name, verified phone, status, consent)
//   users/{uid}/emergencyContacts/{id}   a user's private emergency contacts: number, verification and consent state,
//                                        and a pending verification code (stored as a hash)
//   emergencyAlerts/{id}                 SOS alert records (may hold a location the user chose to share)
//   emergencyAlerts/{id}/deliveries/{d}  per-recipient notification results; written ONLY by the notification worker and
//                                        the provider-receipt webhook, so a user can never forge a delivery result
//   emergencyAlerts/{id}/events/{e}      append-only history of the alert
//   notificationJobs/{alertId}           outbox: notification work still to do (lease-based, server only)
//   adminDevices/{id}                    administrator push (FCM) device tokens
//   incidentReports/{id}                 incident reports
//   adminAuditLogs/{id}                  append-only audit trail (written only by the backend)
//
// Why deny-all and not "owners may read their own alerts": a rule that lets a signed-in user read emergencyAlerts would
// also expose delivery results, internal notes and history fields. The backend decides what each caller may see.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
